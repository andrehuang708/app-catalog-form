# PostgreSQL connection string — the app's only database.
# In Docker, docker-compose sets this to the separate db service
# (postgresql://user:pass@db:5432/app?sslmode=disable); for local runs point
# it at your own Postgres. sslmode is decided by this parameter, see
# src/server/pg.ts.
DATABASE_URL=

# Port the API+static server listens on (docker-compose maps 8080→8080).
PORT=8080
